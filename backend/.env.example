# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kuyumcu_pro_official?replicaSet=rs0

# API server
PORT=5000
# development | test | production. Any other value is rejected at start-up.
# In production the server refuses to start on an unsafe configuration:
# CORS_ORIGIN and APP_URL must be explicit https origins (APP_URL must be one of
# CORS_ORIGIN), AUTH_COOKIE_SECURE cannot be false, TRUST_PROXY and MONGO_URI
# must be set explicitly and example secrets are refused.
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
REPORT_TIME_ZONE=Europe/Istanbul
# Client IP detection (rate limiting, audit IPs). Mandatory in production.
#   false            -> no reverse proxy; the socket address is used
#   true / 1         -> exactly one trusted reverse proxy in front of the API
#   2..10            -> number of trusted proxy hops (e.g. CDN + load balancer)
#   10.0.0.0/8,loopback -> comma-separated trusted proxy IPs/CIDRs
# Never enable it without a proxy that overwrites X-Forwarded-For: clients
# could then choose their own IP and bypass rate limits.
# Rate limits: with RATE_LIMIT_SHARED_STORE=mongo (the production default) the
# counters are shared by all API instances through MongoDB; with "off" they
# live in process memory, so also rate-limit at the reverse proxy.
TRUST_PROXY=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ==============================================================================
# SESSIONS ("Beni Hatırla") — access token in memory, rotating HttpOnly refresh cookie
# ==============================================================================
# Access token lifetime in seconds (default 900 = 15 min)
ACCESS_TOKEN_TTL_SECONDS=900
# Normal login: browser-session cookie, server-side absolute lifetime (hours)
SESSION_TTL_HOURS=12
# "Beni Hatırla": persistent cookie lifetime (days)
REMEMBER_ME_TTL_DAYS=30
# A rotated refresh token re-presented within this window (parallel tabs) is a
# benign race; later replays revoke the whole session (token theft).
REFRESH_REUSE_GRACE_SECONDS=30
MAX_ACTIVE_SESSIONS_PER_USER=20
# Cookie flags. Secure defaults to true when NODE_ENV=production.
# SameSite: strict (default) | lax | none (none forces Secure; needed only if
# the SPA and API are on different sites).
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=
PASSWORD_MIN_LENGTH=12

# ==============================================================================
# PASSWORD RESET E-MAIL (SMTP). Without SMTP_HOST the API returns 503 —
# it never pretends an e-mail was sent.
# ==============================================================================
# Public URL of the frontend used in reset links (mandatory in production).
APP_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); STARTTLS is used automatically when offered.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Leave both empty only for an authenticated-by-network relay.
SMTP_USER=
SMTP_PASS=
SMTP_FROM='"Jeweler Pro ERP" <noreply@example.com>'
PASSWORD_RESET_TTL_MINUTES=60
# Minimum seconds between two reset e-mails to the same account.
PASSWORD_RESET_COOLDOWN_SECONDS=60

# The first admin is created once at startup (only while the business has no
# admin account); use a unique email and 14+ character password.
# Break-glass recovery (see backend/SECURITY.md): start once with
# ADMIN_RECOVERY=true AND a fresh ADMIN_RECOVERY_TOKEN (>= 32 random chars,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# to re-activate / re-create ADMIN_EMAIL as admin with ADMIN_PASSWORD. Each
# token works exactly once; the change, session/token revocation and audit
# record are one transaction. Refused while another active admin exists unless
# ADMIN_RECOVERY_OVERRIDE_ACTIVE_ADMINS=true (emergency only, audited).
# Remove all ADMIN_RECOVERY* variables (and ADMIN_PASSWORD) afterwards.
ADMIN_RECOVERY=
ADMIN_RECOVERY_TOKEN=
ADMIN_RECOVERY_OVERRIDE_ACTIVE_ADMINS=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Login protection: per IP+account, per IP and per account limits (15 min).
# Max keys per in-memory limiter table (bounded memory, ~150 bytes per key).
RATE_LIMIT_MAX_ENTRIES=10000
# Days high-volume security telemetry (logins, reset requests) is kept in the
# audit log before MongoDB's TTL index removes it (30-3650, default 180).
AUDIT_TELEMETRY_RETENTION_DAYS=180

# ==============================================================================
# REAL-TIME MARKET DATA ENGINE CONFIGURATION
# ==============================================================================
# Background worker poll interval and cache TTL in milliseconds
MARKET_DATA_INTERVAL_MS=30000
MARKET_DATA_CACHE_TTL_MS=30000

# Public / Free Market Data Providers
GENELPARA_ENABLED=true
TCMB_ENABLED=true

# Licensed Enterprise Providers (Enter credentials when purchased)
# 1. Hasfiyat (Kapalıçarşı & Harem Altın API) - https://altinapi.hasfiyat.com
HASFIYAT_API_URL=
HASFIYAT_API_KEY=

# 2. Nadir Döviz & Kıymetli Madenler API - https://www.nadirdoviz.com.tr
NADIR_DOVIZ_API_URL=
NADIR_DOVIZ_API_KEY=

# 3. İzmir Kuyumcular Odası (İZKO) - https://www.izko.org.tr
IZKO_API_URL=
IZKO_API_KEY=

# 4. Investing.com API
INVESTING_API_URL=
INVESTING_API_KEY=

# 5. Borsa İstanbul (BIST 100 & Darphane Altın Sertifikası ALTIN.S1)
BIST_API_URL=
BIST_API_KEY=

# ==============================================================================
# TENANCY (legacy data attribution only; requests never fall back to these)
# ==============================================================================
# Business id / branch name given to records created before multi-tenancy.
# Set them BEFORE the first start on an existing single-shop database.
DEFAULT_BUSINESS_ID=jeweler_main_01
DEFAULT_BRANCH=Merkez Şube - Kapalıçarşı

# ==============================================================================
# HTTP, LOGGING AND ERROR REPORTING
# ==============================================================================
# Maximum JSON request body (e.g. 512kb, 1mb). Default 1mb.
BODY_LIMIT=1mb
# Requests per minute per client address for the whole API (0 = off, only
# if the reverse proxy limits instead). Default 600.
API_RATE_LIMIT_PER_MINUTE=600
# json | text. Default: json in production, text elsewhere.
LOG_FORMAT=
# Optional: unexpected (5xx) errors are POSTed here as JSON (alerting relay,
# webhook or error-tracking ingest). Bodies, queries and headers are never sent.
ERROR_REPORT_URL=

# ==============================================================================
# FISCAL DOCUMENTS (docs/FISCAL_INTEGRATION.md)
# ==============================================================================
# manual = legal e-Arşiv / ÖKC documents are issued outside the app.
FISCAL_PROVIDER=manual
