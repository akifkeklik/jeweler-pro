# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kuyumcu_pro_official?replicaSet=rs0

# API server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# The first admin is created once at startup; use a unique email and 14+ character password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
