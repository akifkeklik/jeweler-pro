{
  "name": "jeweler-pro",
  "version": "1.0.0",
  "description": "Jeweler Pro web app: jewellery shop management (Vue 3, Vuetify, Vite)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Akif Keklik",
  "repository": {
    "type": "git",
    "url": "https://github.com/akifkeklik/jeweler-pro.git"
  },
  "homepage": "https://github.com/akifkeklik/jeweler-pro#readme",
  "bugs": {
    "url": "https://github.com/akifkeklik/jeweler-pro/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "i18n:build": "node scripts/build-locales.mjs",
    "prebuild": "node scripts/build-locales.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/auth.e2e.mjs",
    "test:e2e:ops": "node tests/e2e/operations.e2e.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
