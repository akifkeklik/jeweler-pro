{
  "name": "jeweler-pro",
  "version": "1.0.0",
  "description": "Jeweler Pro web app: jewellery shop management (Vue 3, Vuetify, Vite)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Akif Keklik",
  "repository": {
    "type": "git",
    "url": "https://github.com/akifkeklik/jeweler-pro.git"
  },
  "homepage": "https://github.com/akifkeklik/jeweler-pro#readme",
  "bugs": {
    "url": "https://github.com/akifkeklik/jeweler-pro/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "i18n:build": "node scripts/build-locales.mjs",
    "prebuild": "node scripts/build-locales.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/auth.e2e.mjs",
    "test:e2e:ops": "node tests/e2e/operations.e2e.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e:visual": "node tests/e2e/visual-qa-phase2.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.11.0",
    "chart.js": "^4.6.1",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "glob@>=9.0.0 <14.0.2": "^14.0.2"
  }
}
